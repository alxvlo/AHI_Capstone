{
  "name": "ahi-capstone-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs",
    "test:run": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs watch",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage",
    "qa:local": "npm run lint && npm run typecheck && npm run test:run",
    "qa:ci": "npm run lint && npm run typecheck && npm run test:coverage",
    "qa:supabase": "npm run audit:roles:all && npm run audit:write:all && npm run audit:auth:logs && npm run audit:auth:e2e",
    "seed:reference": "node --env-file=.env.local scripts/supabase/seed-reference-data.mjs",
    "probe:deptstaff:noclaim:bootstrap": "npx supabase db query --linked --file scripts/supabase/bootstrap-deptstaff-missing-claim-probe.sql",
    "audit:roles:redirect": "node scripts/supabase/run-role-redirect-audit-local.mjs scripts/supabase/audit-role-dashboard-redirects.mjs",
    "audit:roles:protected:all": "node scripts/supabase/run-role-redirect-audit-local.mjs scripts/supabase/audit-protected-routes-all-roles.mjs",
    "audit:roles:smoke:all": "node scripts/supabase/run-role-redirect-audit-local.mjs scripts/supabase/audit-role-smoke-all-roles.mjs",
    "audit:roles:all": "npm run audit:roles:redirect && npm run audit:roles:protected:all && npm run audit:roles:smoke:all",
    "audit:roles:deptstaff:noclaim": "node scripts/supabase/run-role-redirect-audit-local.mjs scripts/supabase/audit-department-staff-missing-claim.mjs",
    "audit:write-policies": "node --env-file=.env.local scripts/supabase/validate-write-policy-baseline.mjs",
    "audit:write:workflow": "node --env-file=.env.local scripts/supabase/validate-workflow-write-matrix.mjs",
    "audit:write:all": "npm run audit:write-policies && npm run audit:write:workflow",
    "audit:auth:logs": "node --env-file=.env.local scripts/supabase/validate-auth-audit-events.mjs",
    "audit:auth:e2e": "node --env-file=.env.local scripts/supabase/validate-auth-e2e.mjs",
    "probe:cleanup": "npx supabase db query --linked --file scripts/supabase/cleanup-probe-users.sql"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.49.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.36.0",
    "lucide-react": "^0.577.0",
    "next": "^15.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.0.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.2",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.14",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}
