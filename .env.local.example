# =============================================================================
# AHI PEME Portal — local environment template
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored; never commit real secrets.
# =============================================================================

# --- Supabase (REQUIRED) -----------------------------------------------------
# Project URL and keys from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser. Used by middleware, server actions,
# audit/seed scripts, and integration tests.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Audit / probe scripts (OPTIONAL) ----------------------------------------
# Required by `npm run qa:supabase` and the `audit:*` / `probe:*` scripts.
# Password shared by seeded probe accounts in your dev/staging Supabase project.
AHI_PROBE_PASSWORD=your-probe-account-password
# Base URL the audit scripts hit when simulating role traffic. Defaults to
# http://localhost:3000 when unset.
AHI_APP_BASE_URL=http://localhost:3000

# --- Playwright E2E (OPTIONAL) -----------------------------------------------
# Override the base URL Playwright targets. Defaults to http://localhost:3000.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# --- Email pipeline (OPTIONAL — needed for release notifications) ------------
# Defaults below point at Resend's free SMTP relay (3,000 emails/month).
# Swap to Postmark, AWS SES, or any SMTP host without code changes.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=replace-with-your-resend-api-key
EMAIL_FROM="AHI PEME <no-reply@yourdomain.example>"
# Shared mailbox notified when a case is released (e.g. releasing@ahi.com.ph).
RELEASING_NOTIFICATION_EMAIL=releasing@yourdomain.example
# Public base URL used inside outbound email links.
PORTAL_BASE_URL=http://localhost:3000
