# Supabase -----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SCRUM-36 Email pipeline --------------------------------------------------------
# Defaults below point at Resend's free SMTP relay (3,000 emails/month).
# For production, swap to Postmark, AWS SES, or any SMTP host without code changes.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=replace-with-your-resend-api-key
EMAIL_FROM="AHI PEME <no-reply@yourdomain.example>"

# Shared mailbox for releasing-staff notifications.
# Real-world: distribution list like releasing@ahi.com.ph
RELEASING_NOTIFICATION_EMAIL=releasing@yourdomain.example

# Public base URL used in email body links.
# Local dev: http://localhost:3000 — production: https://your.deployed.host
PORTAL_BASE_URL=http://localhost:3000

# Optional -----------------------------------------------------------------------
AHI_PROBE_PASSWORD=your-probe-account-password
