.worktrees/
.claude/worktrees/
.vercel
.env*.local

# Parked cloud credentials. Loaded by nothing; kept so cloud access can be
# restored by copying it back over .env.local. Never commit it.
.env.cloud

# Advisor working documents — MUST NOT be committed.
# This repo is public and these files quote the capstone advisor verbatim by name,
# alongside the team's own drafted answers. Root-anchored so the pattern cannot match
# a nested directory (see the 2026-08-15 note in memory-bank/current-sprint.md about
# bare patterns silently ignoring docs/superpowers/plans/).
# If one ever genuinely needs tracking, that is a deliberate `git add -f`, not an accident.
/advisor-*.md

# Agent tooling installed per-machine, not app runtime.
# (`.agent/` singular is already ignored above; `.agents/` plural is a different directory.)
/.agents/
/.claude/skills/
/skills-lock.json

# Onsite question sheets and their answers. These accumulate clinic-supplied
# detail -- patient identifiers, internal numbering, staff names -- and this
# repository is public. Keep the answers out of git; put only the resulting
# structure into a spec.
/onsite-questions-*.md

# Clinic artefacts, recordings and transcripts from onsite visits. These carry
# real patient data -- names, dates of birth, employers, examination dates --
# and this repository is public. Never commit them. Put only the derived
# STRUCTURE into a spec, never the rows.
/*.jpeg
/*.jpg
/*.png
/*.m4a
/*.pdf
/AHI Questions.md
/*ranscript*.md
